<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document_transport_mode"
            inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//th[@name='th_description']" position="after">
            <th name="th_transport_mode" class="text-center"><strong>Shipping</strong></th>
        </xpath>
        <xpath expr="//td[@id='product']" position="after">
            <td name="td_transport_mode" class="text-center">
                <strong t-field="line.transport_mode"/>
            </td>
        </xpath>
    </template>

    <template id="report_purchasequotation_document_transport_mode"
            inherit_id="purchase.report_purchasequotation_document">
        <xpath expr="//th[@name='th_description']" position="after">
            <th name="th_transport_mode" class="text-center"><strong>Shipping</strong></th>
        </xpath>
        <xpath expr="//td[@id='product']" position="after">
            <td name="td_transport_mode" class="text-center">
                <strong t-field="order_line.transport_mode"/>
            </td>
        </xpath>
    </template>
</odoo>
