<odoo>
    <template id="report_purchaseorder_document_hide_discount" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//th[@name='th_discount']" position="attributes">
        <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//span[@t-field='line.discount']/.." position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>
</odoo>
