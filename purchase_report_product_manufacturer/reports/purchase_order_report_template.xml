<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document_product_manufacturer"
            inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//th[@name='th_description']" position="after">
            <t t-set="show_manufacturer"
                t-value="bool(o.order_line.filtered(lambda l: l.product_qty).product_id.manufacturer_id)"/>
            <th t-if="show_manufacturer" name="th_product_manufacturer" class="text-center"><strong>Manufacturer</strong></th>
        </xpath>
        <xpath expr="//td[@id='product']" position="after">
            <td t-if="show_manufacturer" name="td_product_manufacturer" class="text-center">
                <small t-field="line.product_id.manufacturer_id.name"/>
            </td>
        </xpath>
    </template>

    <template id="report_purchasequotation_document_product_manufacturer"
            inherit_id="purchase.report_purchasequotation_document">
        <xpath expr="//th[@name='th_description']" position="after">
            <t t-set="show_manufacturer"
                t-value="bool(o.order_line.filtered(lambda l: l.product_qty).product_id.manufacturer_id)"/>
            <th t-if="show_manufacturer" name="th_product_manufacturer" class="text-center"><strong>Manufacturer</strong></th>
        </xpath>
        <xpath expr="//td[@id='product']" position="after">
            <td t-if="show_manufacturer" name="td_product_manufacturer" class="text-center">
                <small t-field="order_line.product_id.manufacturer_id.name"/>
            </td>
        </xpath>
    </template>
</odoo>
