<odoo>
    <template id="report_purchaseorder_without_taxation"
        inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//th[@name='th_taxes']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//td[@name='td_taxes']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//t[@t-call='purchase.document_tax_totals']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//t[@t-call='purchase.document_tax_totals']" position="after">
            <tr class="border-black o_total" style="font-size: 1.5em">
                <td>
                    <strong>Total</strong>
                </td>
                <td class="text-end">
                    <span t-field="o.amount_untaxed" />
                </td>
            </tr>
            <tr class="border-black">
                <td class="text-end" colspan="2" style="font-size: 0.8em">
                    No taxes included
                </td>
            </tr>
        </xpath>
    </template>

</odoo>
