<odoo>
    <data>
        <record id="view_partner_form" model="ir.ui.view">
            <field name="name">
                res.partner.form (in purchase_security_advanced)
            </field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="purchase_security.view_partner_property_form" />
            <field name="arch" type="xml">
                <field name="purchase_user_id" position="attributes">
                    <attribute name="groups">purchase.group_purchase_manager</attribute>
                </field>
            </field>
        </record>

        <record id="view_res_partner_filter" model="ir.ui.view">
            <field name="name">
                res.partner.select (in purchase_security_advanced)
            </field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="purchase_security.view_res_partner_filter" />
            <field name="arch" type="xml">
                <field name="purchase_user_id" position="attributes">
                    <attribute name="groups">purchase.group_purchase_manager</attribute>
                </field>
                <filter name="purchase_user_id_filter" position="attributes">
                    <attribute name="groups">purchase.group_purchase_manager</attribute>
                </filter>
            </field>
        </record>
    </data>
</odoo>
